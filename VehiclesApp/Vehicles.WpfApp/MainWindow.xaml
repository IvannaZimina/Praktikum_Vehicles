<Window x:Class="Vehicles.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vehicles Application" Height="580" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC">

    <Window.Resources>
        <DataTemplate x:Key="VehicleTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2">
                <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel x:Name="HeadlightsPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="Headlight1" Width="8" Height="8" Fill="#FACC15" Opacity="0.1" Margin="2,0"/>
                    <Ellipse x:Name="Headlight2" Width="8" Height="8" Fill="#FACC15" Opacity="0.1" Margin="2,0"/>
                </StackPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="2x">
                                <DoubleAnimation Storyboard.TargetName="Headlight1" Storyboard.TargetProperty="Opacity" From="0.1" To="1.0" Duration="0:0:0.25"/>
                                <DoubleAnimation Storyboard.TargetName="Headlight2" Storyboard.TargetProperty="Opacity" From="0.1" To="1.0" Duration="0:0:0.25"/>
                                <DoubleAnimation Storyboard.TargetName="Headlight1" Storyboard.TargetProperty="Opacity" From="1.0" To="0.1" Duration="0:0:0.25"/>
                                <DoubleAnimation Storyboard.TargetName="Headlight2" Storyboard.TargetProperty="Opacity" From="1.0" To="0.1" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#991B1B"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#1E293B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="2">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Foreground" Value="#93C5FD"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F172A" Offset="0.0"/>
                <GradientStop Color="#1E1B4B" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="Actions" FontWeight="Bold" FontSize="15" Foreground="#F8FAFC" Margin="0,0,0,10"/>
            <Button x:Name="AddCarButton" Content="Add Car" Click="AddCarButton_Click" Margin="0,0,0,6" HorizontalAlignment="Stretch"/>
            <Button x:Name="AddBoatButton" Content="Add Boat" Click="AddBoatButton_Click" Margin="0,0,0,6" HorizontalAlignment="Stretch"/>
            <Button x:Name="AddAmphibiousButton" Content="Add Amphib." Click="AddAmphibiousButton_Click" Margin="0,0,0,14" HorizontalAlignment="Stretch"/>

            <GroupBox Header="Selected Vehicle">
                <StackPanel VerticalAlignment="Top">
                    <TextBlock x:Name="SelectedVehicleText" Text="Select a vehicle" FontSize="12" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                    <TextBlock x:Name="OdometerText" Text="Odometer: 0 km" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,8"/>

                    <TextBox x:Name="DistanceTextBox" Text="10" VerticalContentAlignment="Center" Height="32" Margin="0,0,0,6" HorizontalAlignment="Stretch"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="DriveButton" Grid.Column="0" Content="Drive" Click="DriveButton_Click" Height="32" Margin="0,0,3,0"/>
                        <Button x:Name="SwimButton" Grid.Column="1" Content="Swim" Click="SwimButton_Click" Height="32" Margin="3,0,0,0"/>
                    </Grid>

                    <Button x:Name="RemoveButton" Content="Remove from Garage" Click="RemoveButton_Click" Style="{StaticResource DangerButton}" Height="32" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="Car Garage" Margin="0,0,6,0">
                    <ListBox x:Name="CarGarageListBox" SelectionChanged="CarGarageListBox_SelectionChanged" ItemTemplate="{StaticResource VehicleTemplate}"/>
                </GroupBox>

                <GroupBox Grid.Column="1" Header="Boat Garage" Margin="6,0,0,0">
                    <ListBox x:Name="BoatGarageListBox" SelectionChanged="BoatGarageListBox_SelectionChanged" ItemTemplate="{StaticResource VehicleTemplate}"/>
                </GroupBox>
            </Grid>

            <GroupBox Grid.Row="1" Header="Activity Log" Margin="0,6,0,0">
                <TextBox x:Name="LogTextBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </GroupBox>
        </Grid>
    </Grid>
</Window>